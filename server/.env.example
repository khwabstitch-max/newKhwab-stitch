NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/khwab-stitch?replicaSet=rs0
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
# Generate with: node -e "console.log(require('node:crypto').randomBytes(64).toString('base64url'))"
# This is a server secret, never a VITE_ variable. Minimum 48 decoded random bytes.
JWT_SECRET=replace_with_your_generated_base64url_secret
IMAGEKIT_PRIVATE_KEY=private_replace_me
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# Set true ONLY after restricting ALL unsigned image requests in ImageKit and testing privacy.
IMAGEKIT_PRIVATE_POLICY_VERIFIED=false
# Optional Google Identity Services web OAuth client. Empty keeps Google controls hidden.
GOOGLE_CLIENT_ID=
# Optional recovery/verification: configure all three together; verified sender required.
# Server-only key. PUBLIC_WEB_URL is the exact frontend origin, without a trailing slash.
RESEND_API_KEY=
EMAIL_FROM=
PUBLIC_WEB_URL=
