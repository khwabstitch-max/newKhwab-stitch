{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "khwab-stitch-web": {
      "root": "client",
      "framework": "vite"
    },
    "khwab-stitch-api": {
      "root": "server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "khwab-stitch-api"
      }
    },
    {
      "source": "/health/(.*)",
      "destination": {
        "service": "khwab-stitch-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "khwab-stitch-web"
      }
    }
  ]
}
