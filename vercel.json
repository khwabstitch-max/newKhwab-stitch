{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm run setup",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": { "api/index.js": { "maxDuration": 60 } },
  "routes": [
    { "src": "/api(?:/.*)?", "dest": "/api/index.js" },
    { "src": "/health/(?:live|ready)", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(?:assets|brand|design-library)/.*", "status": 404 },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
