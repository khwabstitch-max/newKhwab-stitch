{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "khwab-stitch-web": {
      "root": "client",
      "framework": "vite",
      "routes": [
        { "handle": "filesystem" },
        { "src": "/(?:assets|brand|design-library|design-guides|images)/.*", "status": 404 },
        { "src": "/.*", "dest": "/index.html" }
      ]
    },
    "khwab-stitch-api": {
      "root": "server",
      "framework": "express",
      "entrypoint": "src/vercel.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "khwab-stitch-api"
      }
    },
    {
      "source": "/health/(.*)",
      "destination": {
        "service": "khwab-stitch-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "khwab-stitch-web"
      }
    }
  ]
}
